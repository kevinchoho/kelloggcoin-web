<h1>KelloggCoin Ledger</h1>

<!-- Step 1: List all transactions, starting with the ICO -->

cat > app/views/transactions/index.html.erb << 'EOF'

<h1>Transaction List (100 Transactions)</h1>

<ol>
    <li>
      <% if transaction.from_user %>
        <%= "#{transaction.amount} KC from #{transaction.from_user.name} to #{transaction.to_user.name}" %>
      <% else %>
        <%= "Initial coin offering: #{transaction.amount} to #{transaction.to_user.name}" %>
      <% end %>
    </li>
  <% end %>
</ol>
EOF
<!-- Step 2: Calculate and display the balances -->
puts "User Balances"
puts "============="
puts ""

# Loop through all users (no hard-coding)
User.all.each do |user|

  # Sum of money received
  total_received = Transaction.where({ "to_user_id" => user.id }).sum("amount")

  # Sum of money sent
  total_sent = Transaction.where({ "from_user_id" => user.id }).sum("amount")

  # Calculate balance
  balance = total_received - total_sent

  # Display result
  puts "Balance for #{user.name}: #{balance} KC"
end

