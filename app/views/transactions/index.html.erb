<h1>KelloggCoin Ledger</h1>

<h2>Transaction List (<%= @transactions.count %> Transactions)</h2>

<ol>
  <% @transactions.each do |transaction| %>
    <li>
      <% if transaction.from_user_id %>
        <%= "#{transaction.amount} KC from #{User.find(transaction.from_user_id).name} to #{User.find(transaction.to_user_id).name}" %>
      <% else %>
        <%= "Initial coin offering: #{transaction.amount} KC to #{User.find(transaction.to_user_id).name}" %>
      <% end %>
    </li>
  <% end %>
</ol>

